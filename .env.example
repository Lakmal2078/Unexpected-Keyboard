# Environment variables for Unexpected Keyboard builds and signing
# Copy this file to .env or export these variables in your shell / CI environment.
#
# NOTE: The default local debug keystore password ('debug0') is intended solely for local
# development and testing. NEVER use debug keystores or insecure credentials for production release signing.

# --- Debug Signing (Local / CI) ---
# DEBUG_KEYSTORE=debug.keystore
# DEBUG_KEYSTORE_PASSWORD=debug0
# DEBUG_KEY_ALIAS=debug
# DEBUG_KEY_PASSWORD=debug0

# --- Release Signing (Production Distribution) ---
# Do NOT check release keys into git. Store them in secure CI secrets or private vault.
# RELEASE_KEYSTORE=/path/to/release.keystore
# RELEASE_KEYSTORE_PASSWORD=your_secure_keystore_password
# RELEASE_KEY_ALIAS=your_release_key_alias
# RELEASE_KEY_PASSWORD=your_secure_key_password

# --- Local Termux / PRoot Build Setting (Only if building on ARM64 Termux/PRoot) ---
# android.aapt2FromMavenOverride=/data/data/com.termux/files/usr/bin/aapt2
