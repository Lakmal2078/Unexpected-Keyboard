# ==============================================================================
# Unexpected Keyboard Environment Configuration Template (.env.example)
# ==============================================================================

# --- Production Release Signing ---
RELEASE_KEYSTORE=release.keystore
RELEASE_KEYSTORE_PASSWORD=your_keystore_password_here
RELEASE_KEY_ALIAS=release
RELEASE_KEY_PASSWORD=your_key_password_here

# --- Local Debug Signing ---
DEBUG_KEYSTORE=debug.keystore
DEBUG_KEYSTORE_PASSWORD=android
DEBUG_KEY_ALIAS=androiddebugkey
DEBUG_KEY_PASSWORD=android

# --- Local Termux / PRoot ARM64 Build Setting ---
# android.aapt2FromMavenOverride=/data/data/com.termux/files/usr/bin/aapt2

# Base64 encoded release keystore for GitHub Actions / CI signing
# Generate with: base64 -w 0 release.keystore
RELEASE_KEYSTORE_BASE64=
